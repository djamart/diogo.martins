---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { contactLinks, profile } from '../data/profile';

const t = useTranslations(getLangFromUrl(Astro.url, import.meta.env.BASE_URL));
---

<BaseLayout title={t('contact.title')}>
  <h1>{t('contact.title')}</h1>
  <p>{t('contact.intro')}</p>
  <ul class="links">
    {contactLinks.map((link) => (
      <li>
        <a href={link.href} data-testid={`contact-${link.id}`}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <p class="meta">{profile.location}</p>
</BaseLayout>

<style>
  .links {
    padding-left: 0;
    list-style: none;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .links li + li {
    margin-top: 0.5rem;
  }
</style>
