---
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localeStaticPaths, useTranslations } from '../../i18n/utils';
import { qualityGates } from '../../data/quality';
import { formatPercent, loadQualityReport } from '../../quality/report';
import {
  coverageMinimum,
  lighthouseMinimum,
  passRate,
  pointOnCircle,
  ringDash,
  summarize,
} from '../../quality/summary';
import { loadSkills } from '../../quality/skills';
import { formatDeployDate, linePoints, loadHistory, niceMax } from '../../quality/history';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url, import.meta.env.BASE_URL);
const t = useTranslations(lang);
const repo = 'https://github.com/djamart/diogo.martins';
const report = loadQualityReport(join(process.cwd(), 'reports'), process.env);
const skills = loadSkills(join(process.cwd(), '.claude', 'skills'));
const hasResults = Boolean(
  report.unit || report.coverage || report.e2e.length > 0 || report.lighthouse || report.links,
);
const summary = summarize(report);
const pullRequestGates = qualityGates.filter((gate) => gate.stage === 'pull-request');
const deployGates = qualityGates.filter((gate) => gate.stage === 'deploy');
const coverageMetrics = ['lines', 'branches', 'functions', 'statements'] as const;
const lighthouseCategories = ['performance', 'accessibility', 'bestPractices', 'seo'] as const;
// Gauge geometry, in the units of the SVG viewBox (0 0 100 100).
const ring = { radius: 42, center: 50 };
const minimumTick = {
  from: pointOnCircle(lighthouseMinimum, ring.radius - 7, ring.center),
  to: pointOnCircle(lighthouseMinimum, ring.radius + 7, ring.center),
};
// Trend charts: one plot area per chart, in the units of the SVG viewBox (0 0 320 160).
const history = loadHistory(join(process.cwd(), 'reports'), report);
const latestDeploy = history.at(-1);
const plot = { left: 36, top: 10, width: 272, height: 116 };
const testsArea = { ...plot, min: 0, max: niceMax(Math.max(0, ...history.map((d) => d.tests))) };
const scoresArea = { ...plot, min: coverageMinimum, max: 100 };
const testsTicks = [0, testsArea.max / 2, testsArea.max];
const scoresTicks = [coverageMinimum, 90, 100];
const tickY = (value: number, area: { min: number; max: number }) =>
  plot.top + plot.height - ((value - area.min) / (area.max - area.min)) * plot.height;
const perBrowser = report.e2e[0]
  ? report.e2e[0].passed + report.e2e[0].flaky + report.e2e[0].failed
  : undefined;
---

<BaseLayout title={t('quality.title')}>
  <h1>{t('quality.title')}</h1>
  <p>{t('quality.intro')}</p>

  <h2>{t('quality.results.title')}</h2>
  {hasResults ? (
    <div data-testid="results">
      <p>{t('quality.results.intro')}</p>
      <ul class="stats" data-testid="summary">
        {summary.unitPassed !== undefined && (
          <li class="stat">
            <strong>{summary.unitPassed}</strong>
            <span>{t('quality.summary.unit')}</span>
          </li>
        )}
        {summary.browserRuns && (
          <li class="stat">
            <strong>{summary.browserRuns.passed}</strong>
            <span>
              {t('quality.summary.browserRuns').replace(
                '{browsers}',
                String(summary.browserRuns.browsers),
              )}
            </span>
          </li>
        )}
        {summary.lowestCoverage && (
          <li class="stat">
            <strong>{formatPercent(summary.lowestCoverage.value)}</strong>
            <span>
              {t('quality.summary.coverage').replace(
                '{metric}',
                t(`quality.results.${summary.lowestCoverage.metric}`),
              )}
            </span>
          </li>
        )}
        <li class="stat">
          <strong>{summary.failures}</strong>
          <span>{t('quality.summary.failures')}</span>
        </li>
      </ul>
      {report.run && (
        <p class="meta">
          {t('quality.results.commit')} <a href={report.run.commitUrl}>{report.run.commit}</a> ·{' '}
          <a href={report.run.url} data-testid="link-ci-run">
            {t('quality.results.run')}
          </a>
        </p>
      )}
    </div>
  ) : (
    <p data-testid="results-unavailable">{t('quality.results.unavailable')}</p>
  )}

  <h2>{t('quality.gates.title')}</h2>
  <div class="pipeline">
    <p class="step step-start">{t('quality.pipeline.start')}</p>
    <div class="parallel">
      <p class="parallel-label">
        {t('quality.gates.pullRequest')} · {t('quality.pipeline.parallel')}
      </p>
      <ol class="gates" data-testid="gates-pull-request">
        {pullRequestGates.map((gate) => (
          <li class="step" data-testid="gate">
            <strong>{t(gate.nameKey)}</strong>
            <span class="meta">{gate.tools}</span>
            <p>{t(gate.descriptionKey)}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="sequence">
      <p class="parallel-label">{t('quality.gates.deploy')}</p>
      <ol class="gates gates-sequence" data-testid="gates-deploy">
        {deployGates.map((gate) => (
          <li class="step" data-testid="gate">
            <strong>{t(gate.nameKey)}</strong>
            <span class="meta">{gate.tools}</span>
            <p>{t(gate.descriptionKey)}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  {report.unit && perBrowser !== undefined && (
    <section aria-labelledby="pyramid-title">
      <h2 id="pyramid-title">{t('quality.pyramid.title')}</h2>
      <ol class="pyramid" data-testid="pyramid">
        <li class="tier tier-top">
          <span>{t('quality.gate.smoke.name')}</span>
          <span class="meta">{t('quality.pyramid.smoke')}</span>
        </li>
        <li class="tier tier-middle">
          <span>{t('quality.gate.e2e.name')}</span>
          <span class="meta">
            {t('quality.pyramid.e2e').replace('{count}', String(perBrowser))}
          </span>
        </li>
        <li class="tier tier-base">
          <span>{t('quality.gate.unit.name')}</span>
          <span class="meta">{report.unit.total}</span>
        </li>
      </ol>
      <p>{t('quality.pyramid.caption')}</p>
    </section>
  )}

  {report.e2e.length > 0 && (
    <section aria-labelledby="browsers-title">
      <h2 id="browsers-title">{t('quality.browsers.title')}</h2>
      <table class="browsers" data-testid="browsers">
        <thead>
          <tr>
            <th scope="col">{t('quality.browsers.browser')}</th>
            <th scope="col" class="number">
              {t('quality.browsers.passed')}
            </th>
            <th scope="col" class="number">
              {t('quality.browsers.failed')}
            </th>
            <th scope="col" class="number">
              {t('quality.browsers.flaky')}
            </th>
            <th scope="col" class="rate">
              {t('quality.browsers.passRate')}
            </th>
          </tr>
        </thead>
        <tbody>
          {report.e2e.map((result) => (
            <tr>
              <th scope="row">{result.browser}</th>
              <td class="number">{result.passed}</td>
              <td class="number">{result.failed}</td>
              <td class="number">{result.flaky}</td>
              <td class="rate">
                <span class="bar" aria-hidden="true">
                  <span style={`width: ${passRate(result)}%`} />
                </span>
                <span class="meta">{formatPercent(passRate(result))}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {report.coverage && (
    <section aria-labelledby="coverage-title">
      <h2 id="coverage-title">{t('quality.coverage.title')}</h2>
      <ul class="coverage" data-testid="coverage">
        {coverageMetrics.map((metric) => (
          <li>
            <span class="coverage-name">{t(`quality.results.${metric}`)}</span>
            <span class="coverage-track" aria-hidden="true">
              <span class="coverage-fill" style={`width: ${report.coverage![metric]}%`} />
              <span class="coverage-minimum" style={`left: ${coverageMinimum}%`} />
            </span>
            <span class="meta">{formatPercent(report.coverage![metric])}</span>
          </li>
        ))}
      </ul>
      <p class="coverage-legend">
        {t('quality.coverage.minimum').replace('{minimum}', String(coverageMinimum))}
      </p>
    </section>
  )}

  {report.lighthouse && (
    <section aria-labelledby="lighthouse-title">
      <h2 id="lighthouse-title">{t('quality.lighthouse.title')}</h2>
      <ul class="gauges" data-testid="lighthouse">
        {lighthouseCategories.map((category) => (
          <li class="gauge">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle class="gauge-track" cx={ring.center} cy={ring.center} r={ring.radius} />
              <circle
                class="gauge-fill"
                cx={ring.center}
                cy={ring.center}
                r={ring.radius}
                stroke-dasharray={ringDash(report.lighthouse![category], ring.radius)}
              />
              <line
                class="gauge-minimum"
                x1={minimumTick.from.x}
                y1={minimumTick.from.y}
                x2={minimumTick.to.x}
                y2={minimumTick.to.y}
              />
            </svg>
            <strong class="gauge-score">{report.lighthouse![category]}</strong>
            <span class="gauge-name">{t(`quality.results.${category}`)}</span>
          </li>
        ))}
      </ul>
      <p>
        {t('quality.lighthouse.caption')
          .replace('{pages}', String(report.lighthouse.pages))
          .replace('{minimum}', String(lighthouseMinimum))}
      </p>
      {report.links && (
        <p data-testid="results-links">
          {t('quality.links.summary')
            .replace('{checked}', String(report.links.checked))
            .replace('{broken}', String(report.links.broken))}
        </p>
      )}
    </section>
  )}

  {history.length === 1 && (
    <section aria-labelledby="history-title">
      <h2 id="history-title">{t('quality.history.title')}</h2>
      <p data-testid="history-first">{t('quality.history.first')}</p>
    </section>
  )}

  {history.length > 1 && latestDeploy && (
    <section aria-labelledby="history-title" data-testid="history">
      <h2 id="history-title">{t('quality.history.title')}</h2>
      <p>{t('quality.history.intro').replace('{count}', String(history.length))}</p>
      <div class="trends">
        <figure class="trend">
          <h3>{t('quality.history.tests')}</h3>
          <svg viewBox="0 0 320 160" aria-hidden="true">
            {testsTicks.map((tick) => (
              <g>
                <line
                  class="trend-grid"
                  x1={plot.left}
                  x2={plot.left + plot.width}
                  y1={tickY(tick, testsArea)}
                  y2={tickY(tick, testsArea)}
                />
                <text
                  class="trend-axis"
                  x={plot.left - 6}
                  y={tickY(tick, testsArea) + 4}
                  text-anchor="end"
                >
                  {tick}
                </text>
              </g>
            ))}
            <g transform={`translate(${plot.left} ${plot.top})`}>
              <polyline
                class="trend-line"
                points={linePoints(
                  history.map((d) => d.tests),
                  testsArea,
                )}
              />
            </g>
            <text class="trend-axis" x={plot.left} y="152">
              {formatDeployDate(history[0]!.date, lang)}
            </text>
            <text class="trend-axis" x={plot.left + plot.width} y="152" text-anchor="end">
              {formatDeployDate(latestDeploy.date, lang)}
            </text>
          </svg>
          <figcaption>
            {t('quality.history.testsCaption')
              .replace('{first}', String(history[0]!.tests))
              .replace('{last}', String(latestDeploy.tests))}
          </figcaption>
        </figure>
        <figure class="trend">
          <h3>{t('quality.history.scores')}</h3>
          <svg viewBox="0 0 320 160" aria-hidden="true">
            {scoresTicks.map((tick) => (
              <g>
                <line
                  class="trend-grid"
                  x1={plot.left}
                  x2={plot.left + plot.width}
                  y1={tickY(tick, scoresArea)}
                  y2={tickY(tick, scoresArea)}
                />
                <text
                  class="trend-axis"
                  x={plot.left - 6}
                  y={tickY(tick, scoresArea) + 4}
                  text-anchor="end"
                >
                  {tick}
                </text>
              </g>
            ))}
            <g transform={`translate(${plot.left} ${plot.top})`}>
              <polyline
                class="trend-line"
                points={linePoints(
                  history.map((d) => d.coverage),
                  scoresArea,
                )}
              />
              <polyline
                class="trend-line trend-line-second"
                points={linePoints(
                  history.map((d) => d.lighthouse),
                  scoresArea,
                )}
              />
            </g>
            <text class="trend-axis" x={plot.left} y="152">
              {formatDeployDate(history[0]!.date, lang)}
            </text>
            <text class="trend-axis" x={plot.left + plot.width} y="152" text-anchor="end">
              {formatDeployDate(latestDeploy.date, lang)}
            </text>
          </svg>
          <ul class="trend-legend">
            <li>
              <span class="swatch" aria-hidden="true" />
              {t('quality.history.coverage')}
            </li>
            <li>
              <span class="swatch swatch-second" aria-hidden="true" />
              {t('quality.history.lighthouse')}
            </li>
          </ul>
          <figcaption>
            {t('quality.history.scoresCaption')
              .replace('{coverage}', formatPercent(latestDeploy.coverage))
              .replace('{lighthouse}', String(latestDeploy.lighthouse))}
          </figcaption>
        </figure>
      </div>
      <details class="trend-numbers">
        <summary>{t('quality.history.table')}</summary>
        <table>
          <thead>
            <tr>
              <th scope="col">{t('quality.history.date')}</th>
              <th scope="col">{t('quality.history.commit')}</th>
              <th scope="col" class="number">
                {t('quality.history.colTests')}
              </th>
              <th scope="col" class="number">
                {t('quality.history.colCoverage')}
              </th>
              <th scope="col" class="number">
                {t('quality.history.colLighthouse')}
              </th>
            </tr>
          </thead>
          <tbody>
            {[...history].reverse().map((deploy) => (
              <tr>
                <th scope="row">{formatDeployDate(deploy.date, lang)}</th>
                <td>
                  <a href={`${repo}/commit/${deploy.commit}`}>
                    <code>{deploy.commit}</code>
                  </a>
                </td>
                <td class="number">{deploy.tests}</td>
                <td class="number">{formatPercent(deploy.coverage)}</td>
                <td class="number">{deploy.lighthouse}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </section>
  )}

  <p>
    <a href={`${repo}/actions/workflows/ci.yml`} data-testid="link-ci-history">
      {t('quality.results.history')}
    </a>
  </p>

  <h2>{t('quality.ai.title')}</h2>
  <p>{t('quality.ai.p1')}</p>
  <p>{t('quality.ai.p2')}</p>
  <p>
    <a href={`${repo}/blob/main/CLAUDE.md`} data-testid="link-claude-md">
      {t('quality.ai.claudeMd')}
    </a>
  </p>
  <h3>{t('quality.ai.skills')}</h3>
  <ul data-testid="skills">
    {skills.map((skill) => (
      <li>
        <a href={`${repo}/blob/main/${skill.path}`}>
          <code>{skill.name}</code>
        </a>
        : <span lang="en">{skill.summary}</span>
      </li>
    ))}
  </ul>

  <p>
    <a href={`${repo}/blob/main/docs/test-plan.md`} data-testid="link-quality-test-plan">
      {t('quality.testPlan')}
    </a>
  </p>
</BaseLayout>

<style>
  section {
    margin-top: 1rem;
  }

  /* Latest build: one large number per tile. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }

  .stat {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--color-surface);
  }

  .stat strong {
    font-family: var(--font-mono);
    font-size: 2rem;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  /* The pipeline, top to bottom: the pull request, the checks that run side by side, then the
     deploy steps one after another. Arrows are drawn between the steps. */
  .pipeline {
    display: grid;
    gap: 1.75rem;
  }

  .pipeline > * {
    position: relative;
    margin: 0;
  }

  .pipeline > * + *::before,
  .gates-sequence > li + li::before {
    content: '';
    position: absolute;
    top: -1.5rem;
    left: 1.5rem;
    width: 2px;
    height: 1.25rem;
    background: var(--color-accent);
  }

  .step {
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-text);
    border-radius: 0.6rem;
  }

  .step-start {
    width: fit-content;
    font-weight: 600;
  }

  .step .meta {
    display: block;
  }

  .step p {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }

  .parallel {
    padding: 1rem;
    border: 2px dashed var(--color-muted);
    border-radius: 0.9rem;
  }

  .parallel-label {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .gates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gates-sequence {
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  .gates-sequence > li {
    position: relative;
  }

  .gates-sequence > li:last-child {
    border-color: var(--color-accent);
  }

  /* Test pyramid: three bands, widest at the base. */
  .pyramid {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .tier {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    max-width: 100%;
    padding: 0.6rem 1rem;
    border-radius: 0.4rem;
    font-weight: 600;
  }

  .tier-top {
    width: 50%;
    border: 2px solid var(--color-accent);
  }

  .tier-middle {
    width: 75%;
    background: var(--color-surface);
  }

  .tier-base {
    width: 100%;
    color: var(--color-bg);
    background: var(--color-text);
  }

  .tier-base .meta {
    color: inherit;
  }

  /* Browsers: a pass-rate bar per row. */
  .browsers,
  .trend-numbers table {
    width: 100%;
    border-collapse: collapse;
  }

  .browsers th,
  .browsers td,
  .trend-numbers th,
  .trend-numbers td {
    padding: 0.5rem 0.4rem;
    border-bottom: 1px solid var(--color-muted);
    text-align: left;
    vertical-align: middle;
  }

  .browsers .number,
  .trend-numbers .number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .browsers thead th,
  .trend-numbers thead th {
    font-size: 0.9rem;
  }

  .bar {
    display: block;
    height: 0.6rem;
    min-width: 4rem;
    margin-bottom: 0.2rem;
    border-radius: 999px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    background: var(--color-text);
  }

  /* On a phone the pass rate makes the table too wide; the counts beside it say the same. */
  @media (max-width: 36rem) {
    .browsers .rate {
      display: none;
    }

    .browsers,
    .trend-numbers table {
      font-size: 0.9rem;
    }

    .browsers th,
    .browsers td,
    .trend-numbers th,
    .trend-numbers td {
      padding-inline: 0.2rem;
      overflow-wrap: anywhere;
    }

    .browsers thead th,
    .trend-numbers thead th {
      font-size: 0.8rem;
    }
  }

  /* Coverage: a bar per metric, with the minimum as a line in the accent. */
  .coverage {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coverage li {
    display: grid;
    grid-template-columns: 6.5rem 1fr 4rem;
    gap: 0.75rem;
    align-items: center;
  }

  .coverage-track {
    position: relative;
    height: 0.9rem;
    border-radius: 999px;
    background: var(--color-surface);
  }

  .coverage-fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    background: var(--color-text);
  }

  .coverage-minimum {
    position: absolute;
    top: -0.35rem;
    bottom: -0.35rem;
    width: 3px;
    background: var(--color-accent);
  }

  .coverage li .meta {
    margin: 0;
    text-align: right;
  }

  .coverage-legend {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.95rem;
  }

  .coverage-legend::before {
    content: '';
    width: 3px;
    height: 1.1rem;
    background: var(--color-accent);
  }

  /* Last deploys: two small line charts side by side, stacked on a phone. */
  .trends {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .trend {
    margin: 0;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--color-surface);
  }

  .trend h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .trend svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .trend-grid {
    stroke: var(--color-text);
    stroke-opacity: 0.2;
  }

  .trend-axis {
    fill: var(--color-text);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .trend-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .trend-line-second {
    stroke: var(--color-text);
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }

  .trend-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }

  .trend-legend li {
    display: flex;
