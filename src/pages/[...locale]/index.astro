---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localeStaticPaths, useTranslations } from '../../i18n/utils';
import { profile } from '../../data/profile';
import { fileHref, pageHref } from '../../utils/nav';
import { cvFileName } from '../../cv/model';

export const getStaticPaths = localeStaticPaths;

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url, base);
const t = useTranslations(lang);
---

<BaseLayout>
  <h1>{t('home.greeting')}</h1>
  <p class="role" data-testid="role">
    {profile.title}
  </p>
  <p class="pillars" data-testid="pillars">
    {profile.pillars.map((pillar) => pillar[lang]).join(' · ')}
  </p>
  <p class="intro">{t('home.intro')}</p>
  <p class="actions">
    <a class="button" href={pageHref(base, 'contact', lang)} data-testid="cta-contact">
      {t('home.ctaContact')}
    </a>
    <a
      class="button button-secondary"
      href={pageHref(base, 'experience', lang)}
      data-testid="cta-experience"
    >
      {t('home.ctaExperience')}
    </a>
    <a
      class="button button-secondary"
      href={fileHref(base, cvFileName)}
      download
      hreflang="en"
      data-testid="cta-cv"
    >
      {t('home.ctaCv')}
    </a>
  </p>
  <p class="proof">{t('home.proof')}</p>
</BaseLayout>

<style>
  .role {
    margin-bottom: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .pillars {
    margin-top: 0.25rem;
    color: var(--color-muted);
  }

  .intro {
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .proof {
    margin-top: 2.5rem;
    padding: 1rem;
    border-left: 4px solid var(--color-accent);
    font-size: 0.95rem;
  }
</style>
