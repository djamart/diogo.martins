---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import {
  formatPostDate,
  isoDate,
  parsePostId,
  postLanguages,
  published,
  readingMinutes,
} from '../../../blog/posts';
import { pageHref } from '../../../utils/nav';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return published(posts).map((post) => {
    const { lang, slug } = parsePostId(post.id);
    return {
      params: { locale: lang === defaultLang ? undefined : lang, slug },
      props: { post, availableIn: postLanguages(posts, slug) },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  availableIn: ReturnType<typeof postLanguages>;
}

const { post, availableIn } = Astro.props;
const base = import.meta.env.BASE_URL;
const { lang } = parsePostId(post.id);
const t = useTranslations(lang);
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
---

<BaseLayout title={title} description={description} availableIn={availableIn} fallbackPath="blog">
  <article class="post" data-testid="post">
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={isoDate(pubDate)}>{formatPostDate(pubDate, lang)}</time>
      {' · '}
      <span data-testid="reading-time">
        {t('blog.readingTime').replace('{minutes}', String(readingMinutes(post.body ?? '')))}
      </span>
      {updatedDate && (
        <span data-testid="updated">
          {` · ${t('blog.updated')} `}
          <time datetime={isoDate(updatedDate)}>{formatPostDate(updatedDate, lang)}</time>
        </span>
      )}
    </p>
    <Content />
  </article>
  <p>
    <a href={pageHref(base, 'blog', lang)} data-testid="link-blog">
      {t('blog.back')}
    </a>
  </p>
</BaseLayout>
