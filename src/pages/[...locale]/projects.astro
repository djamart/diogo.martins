---
// Projects moved to the home page while the site is the only one. The old address still works.
import { getLangFromUrl, localeStaticPaths } from '../../i18n/utils';
import { pageHref } from '../../utils/nav';

export const getStaticPaths = localeStaticPaths;

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url, base);

return Astro.redirect(`${pageHref(base, '', lang)}#project`);
---
