---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localeStaticPaths, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = getLangFromUrl(Astro.url, import.meta.env.BASE_URL);
const t = useTranslations(lang);
const repo = 'https://github.com/djamart/diogo.martins';
---

<BaseLayout title={t('projects.title')}>
  <h1>{t('projects.title')}</h1>
  <p>{t('projects.intro')}</p>

  <article data-testid="project">
    <h2>{t('projects.site.title')}</h2>
    <p>{t('projects.site.description')}</p>
    <ul>
      <li>
        <a href={repo} data-testid="link-repo">
          {t('projects.site.source')}
        </a>
      </li>
      <li>
        <a href={`${repo}/blob/main/docs/test-plan.md`} data-testid="link-test-plan">
          {t('projects.site.testPlan')}
        </a>
      </li>
    </ul>
  </article>
</BaseLayout>
