---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
// The Latin files of the heading and body fonts, preloaded so the first paint uses them.
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import ThemeIcon from '../components/ThemeIcon.astro';
import { themeCss } from '../styles/tokens';
import { languages, languageTags, type Lang } from '../i18n/ui';
import { allLanguages, getLangFromUrl, languageCode, useTranslations } from '../i18n/utils';
import {
  alternateLinks,
  navFoldCss,
  fileHref,
  isCurrentPage,
  languageMenuHref,
  navItems,
  pageHref,
  pagePath,
} from '../utils/nav';
import { themeChoices, themeStorageKey } from '../utils/theme';
import { contactLinks } from '../data/profile';
import { cvFileName } from '../cv/model';

interface Props {
  title?: string;
  /** The page's own summary for search results; the site description if absent. */
  description?: string;
  /** False for a page outside the language structure (404): it gets no alternates. */
  translated?: boolean;
  /** The languages the page exists in, for a page that is not in all of them (a blog post). */
  availableIn?: Lang[];
  /** Where the language menu leads in a language the page is not in. */
  fallbackPath?: string;
}

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url, base);
const t = useTranslations(lang);
const {
  title,
  description,
  translated = true,
  availableIn = allLanguages,
  fallbackPath,
} = Astro.props;
// The language menu leads to the same page in each language, or home if the page has none.
const path = translated ? pagePath(Astro.url.pathname, base) : '';
const alternates =
  translated && Astro.site ? alternateLinks(Astro.site, base, path, availableIn) : [];
// The footer offers the two fastest ways to reach Diogo, plus the CV.
const footerLinks = contactLinks.filter((link) => link.id === 'email' || link.id === 'linkedin');
const pageTitle = title ? `${title} | Diogo Martins` : t('site.title');
// The menu links, shown in a row in the header or, when they do not fit, in the menu panel.
const menuLinks = navItems.map((item) => ({
  href: pageHref(base, item.path, lang),
  label: t(item.labelKey),
  current: isCurrentPage(Astro.url.pathname, base, item.path, lang),
  testId: `nav-${item.path || 'home'}`,
}));
---

<!doctype html>
<html lang={languageTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t('site.description')} />
    <link rel="icon" type="image/svg+xml" href={fileHref(base, 'favicon.svg')} />
    <title>{pageTitle}</title>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('blog.feedTitle')}
      href={`${pageHref(base, 'blog', lang)}rss.xml`}
    />
    <style is:inline set:html={themeCss()}></style>
    <style is:inline set:html={navFoldCss()}></style>
    <!-- Applies a stored theme before the first paint, so the page never flashes the other one. -->
    <script is:inline define:vars={{ themeStorageKey }}>
      try {
        const stored = localStorage.getItem(themeStorageKey);
        if (stored === 'light' || stored === 'dark')
          document.documentElement.dataset.theme = stored;
      } catch {
        // Storage blocked: follow the OS colour scheme.
      }
    </script>
    <noscript>
      <style>
        /* Without the script the header never learns the page scrolled, so it is always opaque. */
        .site-header {
          background-color: var(--color-bg);
        }
        /* The menu button needs the script to open, so the links stay in the header and wrap. */
        .site-header .menu-button {
          display: none !important;
        }
        .site-header .site-nav {
          display: block !important;
        }
        .language-button {
          display: none;
        }
        .language-menu .language-options[hidden] {
          position: static;
          display: flex !important;
          border: 0;
          padding: 0;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t('nav.skip')}
    </a>
    <header class="site-header">
      <!-- Shown only when the window is too narrow for the links (see navFoldWidth). -->
      <button
        type="button"
        class="menu-button"
        aria-label={t('nav.open')}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <nav class="site-nav" aria-label={t('nav.label')}>
        <ul>
          {menuLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
                data-testid={link.testId}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-tools">
        <!-- Without JavaScript the list shows inline instead (see the <noscript> style in <head>). -->
        <div class="language-menu" data-testid="language-menu">
          <button
            type="button"
            class="language-button"
            aria-label={`${t('language.label')}: ${languageCode(lang)}`}
            aria-expanded="false"
            aria-controls="language-options"
          >
            {languageCode(lang)}
          </button>
          <ul id="language-options" class="language-options" hidden>
            {allLanguages.map((option) => (
              <li>
                <a
                  href={languageMenuHref(base, path, option, availableIn, fallbackPath)}
                  lang={languageTags[option]}
                  hreflang={languageTags[option]}
                  aria-current={option === lang ? 'true' : undefined}
                >
                  {languages[option]}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <!-- Hidden until the script below runs: without JavaScript the OS colour scheme applies. -->
        <div class="theme-menu" data-testid="theme-menu" data-current="system" hidden>
          <button
            type="button"
            class="theme-button"
            aria-label={t('theme.label')}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="theme-options"
          >
            {themeChoices.map((choice) => (
              <ThemeIcon choice={choice} />
            ))}
          </button>
          <ul id="theme-options" role="menu" aria-label={t('theme.label')} hidden>
            {themeChoices.map((choice) => (
              <li role="none">
                <button
                  type="button"
                  role="menuitemradio"
                  aria-checked={choice === 'system' ? 'true' : 'false'}
                  tabindex="-1"
                  data-choice={choice}
                >
                  <ThemeIcon choice={choice} />
                  {t(`theme.${choice}` as const)}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <!-- The same links in a panel from the left, for windows too narrow to show them in a row. -->
      <dialog id="site-menu" class="site-menu" aria-label={t('nav.menu')}>
        <div class="site-menu-panel">
          <button type="button" class="menu-close" aria-label={t('nav.close')}>
            <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <nav aria-label={t('nav.label')}>
            <ul>
              {menuLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </dialog>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <section class="footer-contact" aria-labelledby="footer-contact-title">
        <p id="footer-contact-title" class="footer-contact-title">
          {t('footer.contactTitle')}
        </p>
        <ul>
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} data-testid={`footer-${link.id}`}>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href={fileHref(base, cvFileName)} download hreflang="en" data-testid="footer-cv">
              {t('footer.cv')}
            </a>
          </li>
        </ul>
      </section>
      <p>
        <a href="https://github.com/djamart/diogo.martins" data-testid="link-source">
          {t('footer.builtWith')}
        </a>
      </p>
    </footer>
    <script>
      import { menuFocusIndex, parseThemeChoice, themeStorageKey } from '../utils/theme';
      import type { ThemeChoice } from '../utils/theme';
      import { languageScrollKey, languageScrollNote, languageScrollTarget } from '../utils/nav';

      // Sticky header: flat at the top of the page, lifted once the page scrolls under it.
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        const markScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 0);
        window.addEventListener('scroll', markScrolled, { passive: true });
        markScrolled();
      }

      // Language menu: a button with the current language that shows the list of languages below.
      const languageMenu = document.querySelector<HTMLElement>('[data-testid="language-menu"]');
      const languageButton = languageMenu?.querySelector<HTMLButtonElement>('button');
      const languageList = languageMenu?.querySelector<HTMLElement>('ul');

      if (languageMenu && languageButton && languageList) {
        const closeLanguages = (returnFocus: boolean) => {
          if (languageList.hidden) return;
          languageList.hidden = true;
          languageButton.setAttribute('aria-expanded', 'false');
          if (returnFocus) languageButton.focus();
        };

        languageButton.addEventListener('click', () => {
          if (!languageList.hidden) return closeLanguages(false);
          languageList.hidden = false;
          languageButton.setAttribute('aria-expanded', 'true');
        });
        languageMenu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeLanguages(true);
        });
        // Closes when focus leaves the menu, e.g. by tabbing past the last language.
        languageMenu.addEventListener('focusout', (event) => {
          if (!languageMenu.contains(event.relatedTarget as Node | null)) closeLanguages(false);
        });
        // pointerdown, not click: iOS Safari fires no click for a tap on text that is not a control.
        document.addEventListener('pointerdown', (event) => {
          if (!languageMenu.contains(event.target as Node)) closeLanguages(false);
        });
        // Switching language keeps the reader's place: the link notes how far down the page was.
        languageList.addEventListener('click', (event) => {
          const link = (event.target as Element).closest('a');
          if (!link) return;
          try {
            sessionStorage.setItem(
              languageScrollKey,
              languageScrollNote(link.href, window.scrollY),
            );
          } catch {
            // Storage blocked: the new page opens at the top.
          }
        });
      }

      // Menu panel: the menu button opens the links in a panel from the left. As a modal dialog it
      // keeps focus inside, closes with Escape and gives focus back to the button when it closes.
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
      const menuPanel = document.querySelector<HTMLDialogElement>('.site-menu');
      if (menuButton && menuPanel) {
        menuButton.addEventListener('click', () => {
          menuPanel.showModal();
          menuButton.setAttribute('aria-expanded', 'true');
        });
        menuPanel.addEventListener('close', () =>
          menuButton.setAttribute('aria-expanded', 'false'),
        );
        menuPanel.querySelector('.menu-close')?.addEventListener('click', () => menuPanel.close());
        // A click outside the panel lands on the dialog itself, whose backdrop fills the window.
        menuPanel.addEventListener('click', (event) => {
          if (event.target === menuPanel) menuPanel.close();
        });
        // A window widened enough to show the links in the header needs no panel.
        window.addEventListener('resize', () => {
          if (menuPanel.open && getComputedStyle(menuButton).display === 'none') menuPanel.close();
        });
      }

      // The page a language switch opened scrolls to where the reader was.
      try {
        const target = languageScrollTarget(
          sessionStorage.getItem(languageScrollKey),
          location.pathname,
        );
        sessionStorage.removeItem(languageScrollKey);
        if (target !== null) window.scrollTo(0, target);
      } catch {
        // Storage blocked: the page stays at the top.
      }

      const root = document.documentElement;
      const container = document.querySelector<HTMLElement>('[data-testid="theme-menu"]');
      const button = container?.querySelector<HTMLButtonElement>('[aria-haspopup="menu"]');
      const menu = container?.querySelector<HTMLElement>('[role="menu"]');

      if (container && button && menu) {
        const items = [...menu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')];
        // The inline script in <head> already applied the stored choice; reflect it in the menu.
        let current = parseThemeChoice(root.dataset.theme);

        const render = () => {
          container.dataset.current = current;
          for (const item of items) {
            item.setAttribute('aria-checked', String(item.dataset.choice === current));
          }
        };

        const choose = (choice: ThemeChoice) => {
          current = choice;
          try {
            if (choice === 'system') localStorage.removeItem(themeStorageKey);
            else localStorage.setItem(themeStorageKey, choice);
          } catch {
            // Storage blocked: the choice lasts until the next page.
          }
          if (choice === 'system') delete root.dataset.theme;
          else root.dataset.theme = choice;
          render();
        };

        const open = (focusIndex: number) => {
          menu.hidden = false;
          button.setAttribute('aria-expanded', 'true');
          items[focusIndex]?.focus();
        };

        const close = (returnFocus: boolean) => {
          if (menu.hidden) return;
          menu.hidden = true;
          button.setAttribute('aria-expanded', 'false');
          if (returnFocus) button.focus();
        };

        const currentIndex = () => items.findIndex((item) => item.dataset.choice === current);

        button.addEventListener('click', () => (menu.hidden ? open(currentIndex()) : close(false)));
        button.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          event.preventDefault();
          open(event.key === 'ArrowDown' ? 0 : items.length - 1);
        });

        menu.addEventListener('click', (event) => {
          const item = (event.target as Element).closest<HTMLButtonElement>(
            '[role="menuitemradio"]',
          );
          if (!item) return;
          choose(parseThemeChoice(item.dataset.choice));
          close(true);
        });
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            close(true);
            return;
          }
          if (event.key === 'Tab') {
            close(false);
            return;
          }
          const index = menuFocusIndex(
            event.key,
            items.indexOf(document.activeElement as HTMLButtonElement),
            items.length,
          );
          if (index === null) return;
          event.preventDefault();
          items[index].focus();
        });
        // pointerdown, not click: iOS Safari fires no click for a tap on text that is not a control.
        document.addEventListener('pointerdown', (event) => {
          if (!container.contains(event.target as Node)) close(false);
        });

        render();
        container.hidden = false;
      }
    </script>
  </body>
</html>
