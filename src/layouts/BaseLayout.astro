---
import '../styles/global.css';
import { themeCss } from '../styles/tokens';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { isCurrentPage, navItems, pageHref } from '../utils/nav';
import { themeChoices, themeStorageKey } from '../utils/theme';

interface Props {
  title?: string;
}

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url, base);
const t = useTranslations(lang);
const { title } = Astro.props;
const pageTitle = title ? `${title} | Diogo Martins` : t('site.title');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('site.description')} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
    <style is:inline set:html={themeCss()}></style>
    <!-- Applies a stored theme before the first paint, so the page never flashes the other one. -->
    <script is:inline define:vars={{ themeStorageKey }}>
      try {
        const stored = localStorage.getItem(themeStorageKey);
        if (stored === 'light' || stored === 'dark')
          document.documentElement.dataset.theme = stored;
      } catch {
        // Storage blocked: follow the OS colour scheme.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t('nav.skip')}
    </a>
    <header class="site-header">
      <nav aria-label={t('nav.label')}>
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={pageHref(base, item.path)}
                aria-current={
                  isCurrentPage(Astro.url.pathname, base, item.path) ? 'page' : undefined
                }
                data-testid={`nav-${item.path || 'home'}`}
              >
                {t(item.labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <!-- Hidden until the script below runs: without JavaScript the OS colour scheme applies. -->
      <fieldset class="theme-picker" data-testid="theme-picker" hidden>
        <legend class="visually-hidden">{t('theme.label')}</legend>
        {themeChoices.map((choice) => (
          <label title={t(`theme.${choice}` as const)}>
            <input type="radio" name="theme" value={choice} checked={choice === 'system'} />
            <span class="visually-hidden">{t(`theme.${choice}` as const)}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {choice === 'light' && (
                <>
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </>
              )}
              {choice === 'dark' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
              {choice === 'system' && (
                <>
                  <rect x="3" y="4" width="18" height="12" rx="2" />
                  <path d="M8 20h8M12 16v4" />
                </>
              )}
            </svg>
          </label>
        ))}
      </fieldset>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="https://github.com/djamart/diogo.martins" data-testid="link-source">
          {t('footer.builtWith')}
        </a>
      </p>
    </footer>
    <script>
      import { parseThemeChoice, themeStorageKey } from '../utils/theme';

      const root = document.documentElement;
      const picker = document.querySelector<HTMLFieldSetElement>('[data-testid="theme-picker"]');

      if (picker) {
        // The inline script in <head> already applied the stored choice; reflect it in the picker.
        const current = parseThemeChoice(root.dataset.theme);
        for (const option of picker.querySelectorAll<HTMLInputElement>('input')) {
          option.checked = option.value === current;
        }

        picker.addEventListener('change', (event) => {
          const choice = parseThemeChoice((event.target as HTMLInputElement).value);
          try {
            if (choice === 'system') localStorage.removeItem(themeStorageKey);
            else localStorage.setItem(themeStorageKey, choice);
          } catch {
            // Storage blocked: the choice lasts until the next page.
          }
          if (choice === 'system') delete root.dataset.theme;
          else root.dataset.theme = choice;
        });

        picker.hidden = false;
      }
    </script>
  </body>
</html>
