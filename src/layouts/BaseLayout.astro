---
import '../styles/global.css';
import ThemeIcon from '../components/ThemeIcon.astro';
import { themeCss } from '../styles/tokens';
import { languages, languageTags } from '../i18n/ui';
import { allLanguages, getLangFromUrl, languageCode, useTranslations } from '../i18n/utils';
import {
  alternateLinks,
  fileHref,
  isCurrentPage,
  navItems,
  pageHref,
  pagePath,
} from '../utils/nav';
import { themeChoices, themeStorageKey } from '../utils/theme';

interface Props {
  title?: string;
  /** False for a page that exists in one language only (404): it gets no alternates. */
  translated?: boolean;
}

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url, base);
const t = useTranslations(lang);
const { title, translated = true } = Astro.props;
// The language menu leads to the same page in each language, or home if the page has none.
const path = translated ? pagePath(Astro.url.pathname, base) : '';
const alternates = translated && Astro.site ? alternateLinks(Astro.site, base, path) : [];
const pageTitle = title ? `${title} | Diogo Martins` : t('site.title');
---

<!doctype html>
<html lang={languageTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('site.description')} />
    <link rel="icon" type="image/svg+xml" href={fileHref(base, 'favicon.svg')} />
    <title>{pageTitle}</title>
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <style is:inline set:html={themeCss()}></style>
    <!-- Applies a stored theme before the first paint, so the page never flashes the other one. -->
    <script is:inline define:vars={{ themeStorageKey }}>
      try {
        const stored = localStorage.getItem(themeStorageKey);
        if (stored === 'light' || stored === 'dark')
          document.documentElement.dataset.theme = stored;
      } catch {
        // Storage blocked: follow the OS colour scheme.
      }
    </script>
    <noscript>
      <style>
        .language-button {
          display: none;
        }
        .language-menu .language-options[hidden] {
          position: static;
          display: flex !important;
          border: 0;
          padding: 0;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t('nav.skip')}
    </a>
    <header class="site-header">
      <nav aria-label={t('nav.label')}>
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={pageHref(base, item.path, lang)}
                aria-current={
                  isCurrentPage(Astro.url.pathname, base, item.path, lang) ? 'page' : undefined
                }
                data-testid={`nav-${item.path || 'home'}`}
              >
                {t(item.labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-tools">
        <!-- Without JavaScript the list shows inline instead (see the <noscript> style in <head>). -->
        <div class="language-menu" data-testid="language-menu">
          <button
            type="button"
            class="language-button"
            aria-label={`${t('language.label')}: ${languageCode(lang)}`}
            aria-expanded="false"
            aria-controls="language-options"
          >
            {languageCode(lang)}
          </button>
          <ul id="language-options" class="language-options" hidden>
            {allLanguages.map((option) => (
              <li>
                <a
                  href={pageHref(base, path, option)}
                  lang={languageTags[option]}
                  hreflang={languageTags[option]}
                  aria-current={option === lang ? 'true' : undefined}
                >
                  {languages[option]}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <!-- Hidden until the script below runs: without JavaScript the OS colour scheme applies. -->
        <div class="theme-menu" data-testid="theme-menu" data-current="system" hidden>
          <button
            type="button"
            class="theme-button"
            aria-label={t('theme.label')}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="theme-options"
          >
            {themeChoices.map((choice) => (
              <ThemeIcon choice={choice} />
            ))}
          </button>
          <ul id="theme-options" role="menu" aria-label={t('theme.label')} hidden>
            {themeChoices.map((choice) => (
              <li role="none">
                <button
                  type="button"
                  role="menuitemradio"
                  aria-checked={choice === 'system' ? 'true' : 'false'}
                  tabindex="-1"
                  data-choice={choice}
                >
                  <ThemeIcon choice={choice} />
                  {t(`theme.${choice}` as const)}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="https://github.com/djamart/diogo.martins" data-testid="link-source">
          {t('footer.builtWith')}
        </a>
      </p>
    </footer>
    <script>
      import { menuFocusIndex, parseThemeChoice, themeStorageKey } from '../utils/theme';
      import type { ThemeChoice } from '../utils/theme';

      // Language menu: a button with the current language that shows the list of languages below.
      const languageMenu = document.querySelector<HTMLElement>('[data-testid="language-menu"]');
      const languageButton = languageMenu?.querySelector<HTMLButtonElement>('button');
      const languageList = languageMenu?.querySelector<HTMLElement>('ul');

      if (languageMenu && languageButton && languageList) {
        const closeLanguages = (returnFocus: boolean) => {
          if (languageList.hidden) return;
          languageList.hidden = true;
          languageButton.setAttribute('aria-expanded', 'false');
          if (returnFocus) languageButton.focus();
        };

        languageButton.addEventListener('click', () => {
          if (!languageList.hidden) return closeLanguages(false);
          languageList.hidden = false;
          languageButton.setAttribute('aria-expanded', 'true');
        });
        languageMenu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeLanguages(true);
        });
        // Closes when focus leaves the menu, e.g. by tabbing past the last language.
        languageMenu.addEventListener('focusout', (event) => {
          if (!languageMenu.contains(event.relatedTarget as Node | null)) closeLanguages(false);
        });
        // pointerdown, not click: iOS Safari fires no click for a tap on text that is not a control.
        document.addEventListener('pointerdown', (event) => {
          if (!languageMenu.contains(event.target as Node)) closeLanguages(false);
        });
      }

      const root = document.documentElement;
      const container = document.querySelector<HTMLElement>('[data-testid="theme-menu"]');
      const button = container?.querySelector<HTMLButtonElement>('[aria-haspopup="menu"]');
      const menu = container?.querySelector<HTMLElement>('[role="menu"]');

      if (container && button && menu) {
        const items = [...menu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')];
        // The inline script in <head> already applied the stored choice; reflect it in the menu.
        let current = parseThemeChoice(root.dataset.theme);

        const render = () => {
          container.dataset.current = current;
          for (const item of items) {
            item.setAttribute('aria-checked', String(item.dataset.choice === current));
          }
        };

        const choose = (choice: ThemeChoice) => {
          current = choice;
          try {
            if (choice === 'system') localStorage.removeItem(themeStorageKey);
            else localStorage.setItem(themeStorageKey, choice);
          } catch {
            // Storage blocked: the choice lasts until the next page.
          }
          if (choice === 'system') delete root.dataset.theme;
          else root.dataset.theme = choice;
          render();
        };

        const open = (focusIndex: number) => {
          menu.hidden = false;
          button.setAttribute('aria-expanded', 'true');
          items[focusIndex]?.focus();
        };

        const close = (returnFocus: boolean) => {
          if (menu.hidden) return;
          menu.hidden = true;
          button.setAttribute('aria-expanded', 'false');
          if (returnFocus) button.focus();
        };

        const currentIndex = () => items.findIndex((item) => item.dataset.choice === current);

        button.addEventListener('click', () => (menu.hidden ? open(currentIndex()) : close(false)));
        button.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          event.preventDefault();
          open(event.key === 'ArrowDown' ? 0 : items.length - 1);
        });

        menu.addEventListener('click', (event) => {
          const item = (event.target as Element).closest<HTMLButtonElement>(
            '[role="menuitemradio"]',
          );
          if (!item) return;
          choose(parseThemeChoice(item.dataset.choice));
          close(true);
        });
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            close(true);
            return;
          }
          if (event.key === 'Tab') {
            close(false);
            return;
          }
          const index = menuFocusIndex(
            event.key,
            items.indexOf(document.activeElement as HTMLButtonElement),
            items.length,
          );
          if (index === null) return;
          event.preventDefault();
          items[index].focus();
        });
        // pointerdown, not click: iOS Safari fires no click for a tap on text that is not a control.
        document.addEventListener('pointerdown', (event) => {
          if (!container.contains(event.target as Node)) close(false);
        });

        render();
        container.hidden = false;
      }
    </script>
  </body>
</html>
