{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4322 --ignore-lock",
      "startServerReadyPattern": "localhost:4322",
      "url": [
        "http://localhost:4322/diogo.martins/",
        "http://localhost:4322/diogo.martins/about/",
        "http://localhost:4322/diogo.martins/experience/",
        "http://localhost:4322/diogo.martins/projects/",
        "http://localhost:4322/diogo.martins/quality/",
        "http://localhost:4322/diogo.martins/contact/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
