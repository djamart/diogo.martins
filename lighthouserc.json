{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4322 --ignore-lock",
      "startServerReadyPattern": "localhost:4322",
      "url": [
        "http://localhost:4322/diogo.martins/",
        "http://localhost:4322/diogo.martins/about/",
        "http://localhost:4322/diogo.martins/quality/",
        "http://localhost:4322/diogo.martins/blog/",
        "http://localhost:4322/diogo.martins/contact/",
        "http://localhost:4322/diogo.martins/pt/",
        "http://localhost:4322/diogo.martins/pt/about/",
        "http://localhost:4322/diogo.martins/pt/quality/",
        "http://localhost:4322/diogo.martins/pt/blog/",
        "http://localhost:4322/diogo.martins/pt/contact/",
        "http://localhost:4322/diogo.martins/blog/hi-im-diogo/",
        "http://localhost:4322/diogo.martins/pt/blog/hi-im-diogo/",
        "http://localhost:4322/diogo.martins/404.html",
        "http://localhost:4322/diogo.martins/pt/404/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
